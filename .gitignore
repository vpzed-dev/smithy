.terraform/
.terraform.lock.hcl.bak
# An OpenTofu/provider panic dumps a TRACE-level ring buffer here - full HTTP
# traffic including the live API token - regardless of TF_LOG.
crash.log
crash.*.log
# Live container env files; commit only the .env.example templates.
.env
# operator
fingerprints/**
!fingerprints/.gitkeep
inventory/*.yaml
!inventory/example.yaml
# age/sops
keys.txt
*.agekey
# Decrypted copies of secrets.enc.json (sops -d > ...).
*.dec.json
secrets.json
# otel-lgtm: reference/ is a scratch clone of the upstream otel-lgtm repo for
# research into the container's internals
/otel-lgtm/reference/
# Windmill
/windmill/local-dev/node_modules/
# logs/private
/logs/**
!/logs/.gitkeep
private/**
!private/.gitkeep
